# Shared rescue-team login (ONE account for the whole team, as requested)
SAR_USERNAME=rescueteam
SAR_PASSWORD=changeme123

# Secret used to sign session tokens - change for real deployment
JWT_SECRET=replace-this-with-a-long-random-string

# Server port
PORT=4000

# Where the SQLite database file lives. Leave unset to use data/sar.db.
# On some cloud hosts you'll point this at a mounted persistent volume,
# e.g. /data/sar.db - see DEPLOYMENT.md.
# SQLITE_PATH=/data/sar.db

# How long (ms) a channel's last message is considered "fresh" before we
# consider that link dead and fail over to the next-priority channel.
CHANNEL_FRESHNESS_MS=15000
